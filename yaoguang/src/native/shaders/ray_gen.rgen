#version 460
#extension GL_EXT_ray_tracing : require

struct HitPayload {
    vec3 color;
    vec3 normal;
    vec3 albedo;
    vec2 uv;
    float material;
    float distance;
};

struct DynamicObj {
    vec4 posRadius;
    vec4 colorMat;
};

struct ParticleObj {
    vec4 posRadius;
    vec4 colorAge;
};

layout(location = 0) rayPayloadEXT HitPayload payload;

layout(binding = 0, rgba8) uniform writeonly image2D outImage;
layout(binding = 1) uniform accelerationStructureEXT tlas;
layout(binding = 2, std430) readonly buffer VertexBuffer { float verts[]; };
layout(binding = 3, std430) readonly buffer IndexBuffer  { uint  idxs[]; };
layout(binding = 4) uniform sampler2D atlasTex;
layout(binding = 5, std430) readonly buffer DynamicBuffer {
    DynamicObj objs[];
};
layout(binding = 6, std430) readonly buffer ParticleBuffer {
    ParticleObj particles[];
};

layout(push_constant) uniform PC {
    uint maxBounces;
    uint samplesPerPixel;
    uint frameIndex;
    uint pathTracingEnabled;
    float exposure;
    float rayLength;
    float sunIntensity;
    float ambientIntensity;
    float camPosX;
    float camPosY;
    float camPosZ;
    float camDirX;
    float camDirY;
    float camDirZ;
    float camUpX;
    float camUpY;
    float camUpZ;
    float fov;
    float aspect;
    uint denoiserEnabled;
    uint dynamicCount;
    float sunDirX;
    float sunDirY;
    float sunDirZ;
    float rainLevel;
    float thunderLevel;
    uint particleCount;
    float _pad2;
} pc;

uint pcgNext(inout uint s) {
    s = s * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float rnd(inout uint s) { return float(pcgNext(s)) / 4294967296.0; }

vec3 cosHemisphere(vec3 n, inout uint s) {
    float u1 = rnd(s);
    float u2 = rnd(s);
    float r = sqrt(u1);
    float theta = 6.28318530718 * u2;
    vec3 localDir = vec3(r * cos(theta), r * sin(theta), sqrt(max(0.0, 1.0 - u1)));
    vec3 up = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    vec3 bitangent = cross(n, tangent);
    return normalize(tangent * localDir.x + bitangent * localDir.y + n * localDir.z);
}

vec3 aces(vec3 x) {
    const float a = 2.51; const float b = 0.03; const float c = 2.43;
    const float d = 0.59; const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 skyColor(vec3 dir, vec3 sunDir) {
    float sunY = sunDir.y;
    float dayF = smoothstep(-0.10, 0.20, sunY);

    vec3 dayZenith   = vec3(0.20, 0.45, 0.90);
    vec3 dayHorizon  = vec3(0.75, 0.88, 1.00);
    vec3 nightZenith = vec3(0.020, 0.032, 0.075);
    vec3 nightHoriz  = vec3(0.045, 0.060, 0.105);

    vec3 zenith  = mix(nightZenith, dayZenith, dayF);
    vec3 horizon = mix(nightHoriz,  dayHorizon, dayF);

    float y = dir.y;
    vec3 sky;
    if (y >= 0.0) {
        float tt = pow(clamp(y, 0.0, 1.0), 0.5);
        sky = mix(horizon, zenith, tt);
    } else {
        float tt = clamp(-y * 2.5, 0.0, 1.0);
        sky = mix(horizon, vec3(0.030, 0.035, 0.050), tt);
    }

    float sunVis = smoothstep(-0.06, 0.15, sunY) * (1.0 - pc.rainLevel * 0.9);
    float sunDot = max(dot(dir, sunDir), 0.0);
    sky += vec3(1.0, 0.96, 0.85) * pow(sunDot, 1024.0) * 80.0 * sunVis;
    sky += vec3(1.0, 0.85, 0.55) * pow(sunDot, 24.0) * 0.7 * sunVis;

    vec3 moonDir = -sunDir;
    float moonVis = smoothstep(0.05, -0.20, sunY);
    float moonDot = max(dot(dir, moonDir), 0.0);
    sky += vec3(0.85, 0.92, 1.10) * pow(moonDot, 2048.0) * 25.0 * moonVis;

    return sky;
}

float raySphere(vec3 ro, vec3 rd, vec3 center, float radius) {
    vec3 oc = ro - center;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    float sq = sqrt(disc);
    float t0 = -b - sq;
    float t1 = -b + sq;
    if (t0 > 0.001) return t0;
    if (t1 > 0.001) return t1;
    return -1.0;
}

bool testDynamic(vec3 ro, vec3 rd, float maxT, out float outT,
                 out vec3 outColor, out vec3 outNormal, out float outMat) {
    outT = maxT;
    bool hitAny = false;
    uint count = pc.dynamicCount;
    if (count > 1024u) count = 1024u;

    for (uint i = 0u; i < count; i++) {
        DynamicObj o = objs[i];
        float t = raySphere(ro, rd, o.posRadius.xyz, o.posRadius.w);
        if (t > 0.0 && t < outT) {
            outT = t;
            outColor = o.colorMat.rgb;
            outNormal = normalize(ro + rd * t - o.posRadius.xyz);
            outMat = o.colorMat.a;
            hitAny = true;
        }
    }
    return hitAny;
}

bool testParticles(vec3 ro, vec3 rd, float maxT, out float outT,
                   out vec3 outColor, out float outAlpha) {
    outT = maxT;
    outColor = vec3(0.0);
    outAlpha = 0.0;
    uint count = pc.particleCount;
    if (count > 4096u) count = 4096u;

    for (uint i = 0u; i < count; i++) {
        ParticleObj p = particles[i];
        float t = raySphere(ro, rd, p.posRadius.xyz, p.posRadius.w);
        if (t > 0.0 && t < outT) {
            outT = t;
            outColor = p.colorAge.rgb;
            outAlpha = p.colorAge.a;
        }
    }
    return outAlpha > 0.0;
}

vec3 tracePath(vec3 camPos, vec3 dirBase, inout uint s) {
    vec3 accum = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 rayOrigin = camPos;
    vec3 rayDir = dirBase;

    vec3 sunDir = normalize(vec3(pc.sunDirX, pc.sunDirY, pc.sunDirZ));
    vec3 sunColor = vec3(1.0, 0.95, 0.85) * pc.sunIntensity;

    int maxB = int(pc.maxBounces);
    if (maxB < 1) maxB = 1;
    if (maxB > 16) maxB = 16;

    bool insideWater = false;
    int transparentHits = 0;

    for (int bounce = 0; bounce < maxB; ++bounce) {
        payload.color = vec3(1.0);
        payload.normal = vec3(0.0);
        payload.albedo = vec3(1.0);
        payload.uv = vec2(0.0);
        payload.material = -1.0;
        payload.distance = pc.rayLength;

        traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0,
                    rayOrigin, 0.01, rayDir, pc.rayLength, 0);

        float dynT;
        vec3 dynColor, dynNormal;
        float dynMat;
        bool dynHit = testDynamic(rayOrigin, rayDir, payload.distance,
                                   dynT, dynColor, dynNormal, dynMat);

        float partT;
        vec3 partColor;
        float partAlpha;
        bool partHit = testParticles(rayOrigin, rayDir,
                                      min(payload.distance, dynHit ? dynT : 1e30),
                                      partT, partColor, partAlpha);

        if (payload.material < 0.0 && !dynHit && !partHit) {
            vec3 sky = skyColor(rayDir, sunDir);
            if (insideWater) sky *= vec3(0.55, 0.75, 1.0);
            accum += throughput * sky;
            break;
        }

        if (partHit && (payload.material < 0.0 || partT < payload.distance)
                     && (!dynHit || partT < dynT)) {
            vec3 pcol = partColor;
            float pluma = dot(pcol, vec3(0.33));
            if (pluma > 0.5) pcol = pcol * 1.8;
            accum += throughput * pcol * (partAlpha * 0.9);
            throughput *= (1.0 - partAlpha * 0.85);
            if (max(throughput.r, max(throughput.g, throughput.b)) < 0.003) break;
            rayOrigin = rayOrigin + rayDir * (partT + 0.02);
            bounce--;
            continue;
        }

        if (dynHit && (payload.material < 0.0 || dynT < payload.distance)) {
            vec3 hitPos = rayOrigin + rayDir * dynT;
            vec3 N = dynNormal;
            int mat = int(dynMat + 0.5);
            vec3 albedo = max(dynColor, vec3(0.02));

            if (mat == 4) {
                accum += throughput * albedo * 8.0;
                break;
            }

            float ndotl = max(dot(N, sunDir), 0.0);
            accum += throughput * albedo * ndotl * sunColor;
            float skyOcc = clamp(0.5 + 0.5 * N.y, 0.0, 1.0);
            vec3 amb = mix(vec3(0.12, 0.16, 0.24), vec3(0.42, 0.52, 0.72), skyOcc);
            accum += throughput * albedo * pc.ambientIntensity * amb;

            if (pc.pathTracingEnabled == 0u) break;
            vec3 rd = cosHemisphere(N, s);
            rayOrigin = hitPos + N * 0.01;
            rayDir = rd;
            throughput *= albedo * 0.9 * 0.96;
            if (max(throughput.r, max(throughput.g, throughput.b)) < 0.003) break;
            continue;
        }

        vec3 hitPos = rayOrigin + rayDir * payload.distance;
        vec3 N = normalize(payload.normal);
        int mat = int(payload.material + 0.5);

        vec4 texSample = texture(atlasTex, payload.uv);
        float alpha = texSample.a;

        if (alpha < 0.5 && mat != 3 && mat != 2) {
            if (++transparentHits > 32) break;
            rayOrigin = hitPos + rayDir * 0.004;
            bounce--;
            continue;
        }

        vec3 albedo = max(texSample.rgb * payload.color, vec3(0.02));

        if (mat == 4) {
            vec3 em = albedo;
            float lum = dot(em, vec3(0.33));
            if (lum < 0.15) em = vec3(1.0, 0.55, 0.15);
            accum += throughput * em * (2.0 + 4.0 * max(0.0, 1.0 - payload.distance * 0.02));
            break;
        }

        if (mat == 1) {
            float metalRough = clamp(dot(albedo, vec3(0.33)) * 0.2 + 0.15, 0.1, 0.5);
            vec3 refl = reflect(rayDir, N);
            rayDir = normalize(refl + metalRough * cosHemisphere(N, s));
            rayOrigin = hitPos + N * 0.01;
            throughput *= albedo;
        } else if (mat == 0) {
            vec3 shadowOrigin = hitPos + N * 0.02;
            payload.material = -1.0;
            payload.distance = pc.rayLength;
            traceRayEXT(tlas,
                        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                        0xFF, 0, 0, 0,
                        shadowOrigin, 0.01, sunDir, 1000.0, 0);
            if (payload.material < 0.0) {
                float ndotl = max(dot(N, sunDir), 0.0);
                accum += throughput * albedo * ndotl * sunColor;
            }
            float skyOcc = clamp(0.5 + 0.5 * N.y, 0.0, 1.0);
            vec3 amb = mix(vec3(0.14, 0.18, 0.26), vec3(0.50, 0.60, 0.80), skyOcc);
            amb *= (0.4 + 0.6 * max(sunDir.y + 0.15, 0.0));
            accum += throughput * albedo * pc.ambientIntensity * amb * 1.5;

            if (pc.pathTracingEnabled == 0u) break;
            vec3 rd = cosHemisphere(N, s);
            rayOrigin = hitPos + N * 0.01;
            rayDir = rd;
            throughput *= albedo;
        } else if (mat == 2) {
            float cosI = clamp(-dot(rayDir, N), 0.0, 1.0);
            float fresnel = pow(1.0 - cosI, 5.0) * 0.7 + 0.08;
            if (rnd(s) < fresnel) {
                rayDir = normalize(reflect(rayDir, N));
                rayOrigin = hitPos + N * 0.01;
                throughput *= mix(vec3(1.0), albedo * 1.8, 0.7);
            } else {
                rayOrigin = hitPos + rayDir * 0.01;
                throughput *= albedo * 1.3;
            }
        } else if (mat == 3) {
            bool entering = dot(rayDir, N) < 0.0;
            if (entering) insideWater = true;
            float eta = 1.333;
            vec3 n = entering ? N : -N;
            float cosI = clamp(-dot(rayDir, n), 0.0, 1.0);
            float sinI2 = 1.0 - cosI * cosI;
            float etaRel = entering ? (1.0 / eta) : eta;
            float sinT2 = sinI2 * etaRel * etaRel;
            float r0 = pow((eta - 1.0) / (eta + 1.0), 2.0);
            float fresnel = r0 + (1.0 - r0) * pow(1.0 - cosI, 5.0);
            if (sinT2 > 1.0 || rnd(s) < fresnel) {
                rayDir = normalize(reflect(rayDir, N));
                rayOrigin = hitPos + N * 0.01;
            } else {
                float cosT = sqrt(max(0.0, 1.0 - sinT2));
                vec3 refr = etaRel * rayDir + (etaRel * cosI - cosT) * n;
                rayDir = normalize(refr);
                rayOrigin = hitPos - n * 0.01;
                if (!entering) insideWater = false;
            }
            throughput *= vec3(0.85, 0.95, 1.0);
        } else {
            if (pc.pathTracingEnabled == 0u) break;
            vec3 rd = cosHemisphere(N, s);
            rayOrigin = hitPos + N * 0.01;
            rayDir = rd;
            throughput *= albedo;
        }

        throughput *= 0.96;
        if (max(throughput.r, max(throughput.g, throughput.b)) < 0.003) break;
    }

    return accum;
}

void main() {
    ivec2 pix = ivec2(gl_LaunchIDEXT.xy);
    ivec2 dim = ivec2(gl_LaunchSizeEXT.xy);

    uint s;
    if (pc.pathTracingEnabled == 0u) {
        s = uint(pix.x) * 1973u + uint(pix.y) * 9277u;
    } else {
        s = uint(pix.x) * 1973u + uint(pix.y) * 9277u + pc.frameIndex * 26699u;
    }
    s |= 1u;

    vec2 uv = (vec2(pix) + vec2(0.5)) / vec2(dim);
    vec2 ndc = uv * 2.0 - 1.0;

    vec3 fwd = normalize(vec3(pc.camDirX, pc.camDirY, pc.camDirZ));
    vec3 up0 = vec3(pc.camUpX, pc.camUpY, pc.camUpZ);
    if (abs(dot(up0, fwd)) > 0.99) up0 = vec3(0.0, 0.0, 1.0);
    vec3 right = normalize(cross(fwd, up0));
    vec3 up = normalize(cross(right, fwd));

    float tanHalf = tan(radians(pc.fov) * 0.5);
    vec3 dirBase = normalize(fwd
        + ndc.x * pc.aspect * tanHalf * right
        + ndc.y * tanHalf * up);

    vec3 camPos = vec3(pc.camPosX, pc.camPosY, pc.camPosZ);

    int spp = int(pc.samplesPerPixel);
    if (pc.pathTracingEnabled == 0u) spp = 2;
    else { if (spp < 1) spp = 1; if (spp > 16) spp = 16; }

    vec3 accum = vec3(0.0);
    for (int i = 0; i < spp; ++i) {
        vec2 jitter = vec2(rnd(s) - 0.5, rnd(s) - 0.5) / vec2(dim);
        vec2 juv = uv + jitter;
        vec2 jndc = juv * 2.0 - 1.0;
        vec3 jdir = normalize(fwd
            + jndc.x * pc.aspect * tanHalf * right
            + jndc.y * tanHalf * up);
        accum += tracePath(camPos, jdir, s);
    }
    accum /= float(spp);

    accum *= pc.exposure;
    accum = aces(accum);

    imageStore(outImage, pix, vec4(accum, 1.0));
}