#version 460
#extension GL_EXT_ray_tracing : require

struct HitPayload {
    vec3 albedo;
    vec3 normal;
    vec3 emissive;
    vec3 transmittance;
    vec2 uv;
    float material;
    float roughness;
    float metalness;
    float distance;
    float skyLight;
    float blockLight;
    int op;
};

layout(location = 0) rayPayloadInEXT HitPayload payload;
hitAttributeEXT vec2 attribs;

layout(binding = 2, std430) readonly buffer VertexBuffer { float verts[]; };
layout(binding = 3, std430) readonly buffer IndexBuffer { uint idxs[]; };
layout(binding = 11, std430) readonly buffer ChunkTable { uvec4 chunkTable[]; };
layout(binding = 4) uniform sampler2D atlasTex;

layout(push_constant) uniform PC {
    uint maxBounces;
    uint samplesPerPixel;
    uint frameIndex;
    uint flags;
    float exposure;
    float rayLength;
    float sunIntensity;
    float ambientIntensity;
    vec4 camPos;
    vec4 camDir;
    vec4 camUp;
    float fov;
    float aspect;
    float time;
    float wetness;
    uint dynamicCount;
    uint particleCount;
    uint pad0;
    uint pad1;
    vec4 sunDir;
    vec4 weather;
    vec4 prevCamPos;
    vec4 prevCamDir;
    vec4 prevCamUp;
    vec4 lens;
    vec4 misc;
    vec4 sunColor;
} pc;

const int STRIDE = 20;

float fetchComponent(uint index, int component) {
    return verts[index * uint(STRIDE) + uint(component)];
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    if (payload.op == 1 && gl_HitTEXT < 0.05) {
        ignoreIntersectionEXT;
        return;
    }
    uvec4 chunk = chunkTable[gl_InstanceCustomIndexEXT];
    uint vbase = chunk.x;
    uint ibase = chunk.y;
    uint prim = ibase + uint(gl_PrimitiveID) * 3u;
    uint i0 = idxs[prim + 0] + vbase;
    float quickMat = fetchComponent(i0, 11);
    float quickAlpha = fetchComponent(i0, 18);
    bool quickCut = quickAlpha > 0.5 || (quickMat > 8.5 && quickMat < 9.5) ||
                    (quickMat > 1.5 && quickMat < 2.5) || (quickMat > 13.5 && quickMat < 14.5);
    if (!quickCut && payload.op == 1) { return; }
    uint i1 = idxs[prim + 1] + vbase;
    uint i2 = idxs[prim + 2] + vbase;

    float b0 = 1.0 - attribs.x - attribs.y;
    float b1 = attribs.x;
    float b2 = attribs.y;

    vec2 uv = vec2(fetchComponent(i0, 9), fetchComponent(i0, 10)) * b0 +
              vec2(fetchComponent(i1, 9), fetchComponent(i1, 10)) * b1 +
              vec2(fetchComponent(i2, 9), fetchComponent(i2, 10)) * b2;

    vec3 wp = vec3(fetchComponent(i0, 0), fetchComponent(i0, 1), fetchComponent(i0, 2)) * b0 +
              vec3(fetchComponent(i1, 0), fetchComponent(i1, 1), fetchComponent(i1, 2)) * b1 +
              vec3(fetchComponent(i2, 0), fetchComponent(i2, 1), fetchComponent(i2, 2)) * b2;
    float material = fetchComponent(i0, 11);
    float alphaTest = fetchComponent(i0, 18);
    if (payload.op == 1 && !(alphaTest > 0.5 || (material > 8.5 && material < 9.5) || (material > 1.5 && material < 2.5) || (material > 13.5 && material < 14.5))) {
        return;
    }

    uv = clamp(uv, vec2(0.0), vec2(1.0));
    float worldPerPixel = 2.0 * gl_HitTEXT * tan(radians(pc.fov) * 0.5) / max(pc.misc.w, 1.0);
    float lod = clamp(log2(max(worldPerPixel * 16.0, 0.25)), 0.0, 2.0);
    ivec2 asize = textureSize(atlasTex, 0);
    vec4 raw = texelFetch(atlasTex, clamp(ivec2(uv * vec2(asize)), ivec2(0), asize - 1), 0);
    float mask = raw.a;
    if (raw.a > 0.99 && max(max(raw.r, raw.g), raw.b) < 0.02) mask = 0.0;
    vec4 texel = vec4(1.0, 1.0, 1.0, mask);
    float alpha = texel.a;

    bool portal = material > 13.5 && material < 14.5;
    bool foliage = material > 8.5 && material < 9.5;
    bool glassy = material > 1.5 && material < 2.5;

    if (portal) {
        if (payload.op == 1) ignoreIntersectionEXT;
    }
    if (payload.op == 1 && alphaTest > 1.5 && alphaTest < 2.5) {
        ignoreIntersectionEXT;
        return;
    }
    if (payload.op == 1 && foliage) {
        payload.transmittance *= 0.45;
        ignoreIntersectionEXT;
        return;
    }
    if (alphaTest > 0.5 || foliage) {
        float threshold = payload.op == 1 ? 0.45 : 0.5;
        if (alpha < threshold) ignoreIntersectionEXT;
    }
    if (glassy && alpha < 0.12) {
        ignoreIntersectionEXT;
    }
    if ((material > 4.5 && material < 5.5) || (material > 6.5 && material < 7.5)) {
        float vy = wp.y - floor(wp.y);
        vec2 hd = abs(fract(wp.xz) - 0.5);
        float flame = (1.0 - smoothstep(0.22, 0.78, vy)) * (1.0 - smoothstep(0.16, 0.46, length(hd)));
        if (flame < 0.34) ignoreIntersectionEXT;
    }

    if (payload.op == 1) {
        vec3 tint = vec3(1.0);
        bool partial = false;
        if (material > 2.5 && material < 3.5) {
            tint = vec3(0.62, 0.82, 0.88);
            partial = true;
        } else if (glassy) {
            tint = mix(vec3(0.55), texel.rgb, 0.55);
            partial = true;
        } else if (foliage) {
            tint = mix(vec3(0.18), vec3(0.82), alpha);
            partial = true;
        }
        if (partial) {
            payload.transmittance *= tint;
            ignoreIntersectionEXT;
        }
        return;
    }
}
