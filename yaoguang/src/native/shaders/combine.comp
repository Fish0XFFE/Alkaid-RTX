#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D diffTex;
layout(binding = 1) uniform sampler2D specTex;
layout(binding = 2) uniform sampler2D viewZTex;
layout(binding = 3, rgba16f) uniform writeonly image2D outHdr;
layout(binding = 4, r32f) uniform writeonly image2D outDepth;

layout(push_constant) uniform PC {
    float exposure;
    float farPlane;
    uint width;
    uint height;
    uint pad0;
    uint pad1;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    vec4 d = texelFetch(diffTex, p, 0);
    vec4 s = texelFetch(specTex, p, 0);
    vec3 c = d.rgb + s.rgb;
    c = min(c, vec3(60000.0));

    float z = texelFetch(viewZTex, p, 0).r;
    imageStore(outHdr, p, vec4(c, 1.0));
    imageStore(outDepth, p, vec4(clamp(z / max(pc.farPlane, 1.0), 0.0, 1.0)));
}
