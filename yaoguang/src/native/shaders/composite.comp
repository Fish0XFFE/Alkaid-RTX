#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D hdrTex;
layout(binding = 1, rgba8) uniform writeonly image2D dstImage;
layout(binding = 2) uniform sampler2D historyTex;
layout(binding = 3) uniform sampler2D motionTex;
layout(binding = 4, rgba16f) uniform writeonly image2D historyOut;
layout(binding = 5) uniform sampler2D depthTex;

layout(push_constant) uniform PC {
    float exposure;
    float sharpen;
    uint width;
    uint height;
    uint srcWidth;
    uint srcHeight;
    uint upscale;
    uint pad0;
    float blend;
    uint reset;
} pc;

vec3 aces(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

float catmullRom(float x) {
    float ax = abs(x);
    if (ax < 1.0) return 1.5 * ax * ax * ax - 2.5 * ax * ax + 1.0;
    if (ax < 2.0) return -0.5 * ax * ax * ax + 2.5 * ax * ax - 4.0 * ax + 2.0;
    return 0.0;
}

vec3 fetchHdr(ivec2 p, ivec2 srcSize) {
    return texelFetch(hdrTex, clamp(p, ivec2(0), srcSize - 1), 0).rgb;
}

vec3 sampleBicubic(ivec2 dst, ivec2 srcSize) {
    vec2 srcPos = (vec2(dst) + 0.5) * (vec2(srcSize) / vec2(pc.width, pc.height)) - 0.5;
    ivec2 base = ivec2(floor(srcPos));
    vec2 f = srcPos - vec2(base);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int y = -1; y <= 2; y++) {
        for (int x = -1; x <= 2; x++) {
            float w = catmullRom(float(x) - f.x) * catmullRom(float(y) - f.y);
            sum += fetchHdr(base + ivec2(x, y), srcSize) * w;
            wsum += w;
        }
    }
    return sum / max(wsum, 1.0e-5);
}

vec3 sanitize(vec3 c) {
    c = mix(c, vec3(0.0), vec3(isnan(c)));
    c = mix(c, vec3(0.0), vec3(isinf(c)));
    return max(c, vec3(0.0));
}

vec3 tonemapped(vec3 hdr) {
    return pow(max(aces(hdr * pc.exposure), vec3(0.0)), vec3(1.0 / 2.2));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    ivec2 srcSize = ivec2(pc.srcWidth, pc.srcHeight);
    vec3 current = sanitize(pc.upscale != 0u ? sampleBicubic(p, srcSize) : fetchHdr(p, srcSize));

    vec2 mbUv = (vec2(p) + 0.5) / vec2(pc.width, pc.height);
    float sceneDepth = texture(depthTex, mbUv).r;

    if (pc.pad0 != 0u && sceneDepth < 0.98) {
        vec2 mvB = texture(motionTex, mbUv).rg;
        float mlen = length(mvB);
        if (mlen > 4.0) {
            float scale = min((mlen - 4.0) * 0.22, 7.0) / mlen;
            vec3 blurSum = current;
            float blurW = 1.0;
            for (int i = 1; i <= 5; i++) {
                float f = float(i) / 5.0;
                float w = 1.0 - 0.62 * f;
                vec2 uA = mbUv + mvB * scale * f / vec2(srcSize);
                if (uA.x > 0.0 && uA.x < 1.0 && uA.y > 0.0 && uA.y < 1.0) {
                    blurSum += sanitize(texture(hdrTex, uA).rgb) * w;
                    blurW += w;
                }
            }
            current = blurSum / blurW;
        }
    }
    vec3 accum = current;
    if (pc.reset == 0u && pc.blend < 0.999f && sceneDepth < 0.98) {
        vec2 uv = (vec2(p) + 0.5) / vec2(pc.width, pc.height);
        vec2 mv = texture(motionTex, uv).rg;
        vec2 prevUv = uv + mv / vec2(srcSize);
        if (prevUv.x > 0.0 && prevUv.x < 1.0 && prevUv.y > 0.0 && prevUv.y < 1.0) {
            vec3 prev = sanitize(texture(historyTex, prevUv).rgb);
            vec3 mn = current;
            vec3 mx = current;
            if (pc.upscale == 0u) {
                for (int y = -2; y <= 2; y++) {
                    for (int x = -2; x <= 2; x++) {
                        vec3 s = fetchHdr(p + ivec2(x, y), srcSize);
                        mn = min(mn, s);
                        mx = max(mx, s);
                    }
                }
            }
            prev = clamp(prev, mn, mx);
            float motionPixels = length(mv);
            float blend = motionPixels > 32.0 ? 1.0 : max(pc.blend, clamp(motionPixels / 32.0, 0.0, 1.0) * 0.85);
            accum = mix(prev, current, blend);
        }
    }

    imageStore(historyOut, p, vec4(min(accum, vec3(60000.0)), 1.0));

    vec3 color = tonemapped(accum);
    if (pc.sharpen > 0.001 && pc.upscale == 0u) {
        vec3 n0 = tonemapped(fetchHdr(p + ivec2(-1, 0), srcSize));
        vec3 n1 = tonemapped(fetchHdr(p + ivec2(1, 0), srcSize));
        vec3 n2 = tonemapped(fetchHdr(p + ivec2(0, -1), srcSize));
        vec3 n3 = tonemapped(fetchHdr(p + ivec2(0, 1), srcSize));
        color += (color - (n0 + n1 + n2 + n3) * 0.25) * pc.sharpen;
    }

    imageStore(dstImage, p, vec4(clamp(color, 0.0, 1.0), 1.0));
}
